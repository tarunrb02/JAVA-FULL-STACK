package Multi_Level;

public class SportsCar extends Car {
	String model;
	
	public static void main(String[] args) {
		SportsCar s=new SportsCar();
		
		s.brand="BMW";
		s.color="red";
		s.price=20000000;
		s.model="M5";
		
		s.start();
		System.out.println(s.brand+" "+s.color+" "+s.price+" "+s.model);
		s.stop();
	}
}
