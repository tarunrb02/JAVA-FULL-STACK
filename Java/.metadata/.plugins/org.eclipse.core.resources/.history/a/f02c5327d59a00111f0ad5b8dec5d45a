package Multi_Level;

public class SportsCar extends Car {
	String model;
	
	public static void main(String[] args) {
		SportsCar s=new SportsCar();
		
		s.brand="BMW";
		s.color="red";
		s.price=3500000.67;
		s.model="M5";
		
		s.start();
		System.out.println(s.brand+" " +s.model+ " " +s.color +" price "+s.price);
		s.stop();
	}
}
